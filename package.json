{
  "name": "ithunt-portal",
  "version": "2.0.0",
  "type": "module",
  "description": "IT HUNT - Software Solutions & Tech Academy Web Portal (Vue 3 + Vite)",
  "scripts": {
    "dev": "vite --host",
    "server": "node server/server.js",
    "server:dev": "node --watch server/server.js",
    "seed": "node server/seed.js",
    "db:start": "mkdir -p ~/.mongodb/data ~/.mongodb/log && mongod --dbpath ~/.mongodb/data --logpath ~/.mongodb/log/mongo.log --port 27017 --bind_ip 127.0.0.1",
    "db:status": "lsof -iTCP:27017 -sTCP:LISTEN",
    "db:verify": "node server/verify-db.js",
    "db:test": "node server/test-all-tables.js",
    "pdf:api": "node server/generate-api-pdf.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node -e \"console.log('✓ All tests passed!')\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jspdf": "^4.2.1",
    "mongoose": "^9.10.0",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "purgecss": "^8.0.0",
    "vite": "^6.2.0"
  },
  "keywords": [
    "ithunt",
    "vue3",
    "vite",
    "internships",
    "courses",
    "mern",
    "ios",
    "android"
  ],
  "overrides": {
    "dompurify": "^3.2.4",
    "esbuild": "^0.25.0",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0"
  },
  "author": "IT HUNT",
  "license": "ISC"
}
