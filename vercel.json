{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/students/(.*)", "destination": "/api/index.js" },
    { "source": "/students", "destination": "/api/index.js" },
    { "source": "/admissions/(.*)", "destination": "/api/index.js" },
    { "source": "/admissions", "destination": "/api/index.js" },
    { "source": "/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/auth", "destination": "/api/index.js" },
    { "source": "/nielit-projects/(.*)", "destination": "/api/index.js" },
    { "source": "/nielit-projects", "destination": "/api/index.js" },
    { "source": "/careers/(.*)", "destination": "/api/index.js" },
    { "source": "/careers", "destination": "/api/index.js" },
    { "source": "/internships/(.*)", "destination": "/api/index.js" },
    { "source": "/internships", "destination": "/api/index.js" },
    { "source": "/events/(.*)", "destination": "/api/index.js" },
    { "source": "/events", "destination": "/api/index.js" },
    { "source": "/reviews/(.*)", "destination": "/api/index.js" },
    { "source": "/reviews", "destination": "/api/index.js" },
    { "source": "/fees/(.*)", "destination": "/api/index.js" },
    { "source": "/fees", "destination": "/api/index.js" },
    { "source": "/certificates/(.*)", "destination": "/api/index.js" },
    { "source": "/certificates", "destination": "/api/index.js" },
    { "source": "/projects/(.*)", "destination": "/api/index.js" },
    { "source": "/projects", "destination": "/api/index.js" },
    { "source": "/contact/(.*)", "destination": "/api/index.js" },
    { "source": "/contact", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/health", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
