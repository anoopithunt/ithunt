{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api?path=api/$1" },
    { "src": "/api", "dest": "/api?path=api" },
    { "src": "/students/(.*)", "dest": "/api?path=students/$1" },
    { "src": "/students", "dest": "/api?path=students" },
    { "src": "/admissions/(.*)", "dest": "/api?path=admissions/$1" },
    { "src": "/admissions", "dest": "/api?path=admissions" },
    { "src": "/auth/(.*)", "dest": "/api?path=auth/$1" },
    { "src": "/auth", "dest": "/api?path=auth" },
    { "src": "/nielit-projects/(.*)", "dest": "/api?path=nielit-projects/$1" },
    { "src": "/nielit-projects", "dest": "/api?path=nielit-projects" },
    { "src": "/careers/(.*)", "dest": "/api?path=careers/$1" },
    { "src": "/careers", "dest": "/api?path=careers" },
    { "src": "/internships/(.*)", "dest": "/api?path=internships/$1" },
    { "src": "/internships", "dest": "/api?path=internships" },
    { "src": "/events/(.*)", "dest": "/api?path=events/$1" },
    { "src": "/events", "dest": "/api?path=events" },
    { "src": "/reviews/(.*)", "dest": "/api?path=reviews/$1" },
    { "src": "/reviews", "dest": "/api?path=reviews" },
    { "src": "/fees/(.*)", "dest": "/api?path=fees/$1" },
    { "src": "/fees", "dest": "/api?path=fees" },
    { "src": "/certificates/(.*)", "dest": "/api?path=certificates/$1" },
    { "src": "/certificates", "dest": "/api?path=certificates" },
    { "src": "/projects/(.*)", "dest": "/api?path=projects/$1" },
    { "src": "/projects", "dest": "/api?path=projects" },
    { "src": "/contact/(.*)", "dest": "/api?path=contact/$1" },
    { "src": "/contact", "dest": "/api?path=contact" },
    { "src": "/admin/(.*)", "dest": "/api?path=admin/$1" },
    { "src": "/admin", "dest": "/api?path=admin" },
    { "src": "/courses/(.*)", "dest": "/api?path=courses/$1" },
    { "src": "/courses", "dest": "/api?path=courses" },
    { "src": "/health", "dest": "/api?path=api/health" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
